{
  "name": "capture",
  "productName": "Capture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite dev\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "dev:web": "vite dev",
    "build": "vite build",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder --linux AppImage",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "app:install": "bash scripts/install.sh",
    "app:uninstall": "bash scripts/uninstall.sh"
  },
  "build": {
    "appId": "dev.matia.capture",
    "productName": "Capture",
    "files": [
      "build/**",
      "electron/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "resources/icon.png",
      "syncDesktopName": true
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ]
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "concurrently": "^10.0.6",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.6.7"
  },
  "description": "Capture a full web page as video or image",
  "author": "matia",
  "desktopName": "capture.desktop"
}
